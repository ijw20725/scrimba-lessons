body {
    margin: 20px;
 
}

.img-width {
    width: 150px;
}

.card {
    width: 400px;
    margin-left: auto;
    margin-right: auto;
    padding: 20px;
    display: flex;
    justify-content: space-around;
    text-align: center;
    background: #CBC3E3;
    color: #2b2839;
    border-bottom: 1px solid #0000FF;
}

.blue {
	border: 1px solid #0000FF
}
